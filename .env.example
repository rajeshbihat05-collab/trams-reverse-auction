# Server Settings
HOST=0.0.0.0
PORT=8000
DEBUG=False
ENVIRONMENT=production

# Database Config (SQLite fallback or PostgreSQL)
DATABASE_URL=postgresql://trams_user:trams_pass@db:5432/trams_db

# Cache & Message Brokers
REDIS_URL=redis://redis:6379/0
CELERY_BROKER_URL=redis://redis:6379/1
CELERY_RESULT_BACKEND=redis://redis:6379/2

# Cryptography Secrets
JWT_SECRET_KEY=trams-production-secure-key-2026-super-secret
JWT_ALGORITHM=HS256

# Storage Paths
UPLOAD_DIR=./uploads
